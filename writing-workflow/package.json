{
  "name": "@local/writing-workflow",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Paper writing workflow panel: staged documents, seven composing skills, extendable instructions.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke-client.mjs && node test/smoke-host.mjs && node test/docx-parse.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}

